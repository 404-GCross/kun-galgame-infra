# Galgame Wiki — frontend env example.
#
# Copy to `.env` (this dir) and fill in the values for your deployment.
# Every var also has a code-level fallback in `nuxt.config.ts`, but those
# fallbacks are dev-localhost values only — production MUST set them.
#
# `NUXT_PUBLIC_*` vars become accessible to client-side code via
# `useRuntimeConfig().public.*`, so DO NOT put secrets here.

# ─── API endpoints ───────────────────────────────────────────────────

# galgame_wiki backend (where /galgame, /tag, /admin, etc. live).
# Same Go binary as OAuth, but a different service started on a
# different port — see apps/api/cmd/galgame.
KUN_GALGAME_WIKI_NUXT_PUBLIC_API_BASE=https://wiki.kungal.com/api

# OAuth server REST base — used for /auth/me, /oauth/token, /oauth/revoke.
KUN_GALGAME_WIKI_NUXT_PUBLIC_AUTH_API_BASE=https://oauth.kungal.com/api/v1

# OAuth /authorize entry — typically same host as AUTH_API_BASE.
# Wiki redirects the browser here at login time.
KUN_GALGAME_WIKI_NUXT_PUBLIC_OAUTH_AUTHORIZE_BASE=https://oauth.kungal.com/api/v1

# ─── OAuth client ────────────────────────────────────────────────────

# Wiki's OAuth client_id, registered in the OAuth admin (`oauth_clients`
# row). MUST be the actual 32-hex-char ID generated when the admin
# created this client — the code fallback `galgame-wiki-admin` is just
# a dev placeholder and won't match anything in production.
#
# Wiki is a PUBLIC client (SPA) → no client_secret. PKCE is mandatory
# (already wired in apps/wiki/app/composables/useOAuthLogin.ts).
KUN_GALGAME_WIKI_NUXT_PUBLIC_OAUTH_CLIENT_ID=

# Where the browser lands after the OAuth code flow completes. MUST be
# registered as an allowed redirect URI on the OAuth client row,
# otherwise /oauth/authorize rejects with invalid_redirect_uri.
KUN_GALGAME_WIKI_NUXT_PUBLIC_OAUTH_REDIRECT_URI=https://wiki.kungal.com/auth/callback

# ─── image_service ───────────────────────────────────────────────────

# CDN base for image_service-served images. Must NOT have a trailing
# slash. Used to resolve `avatar_image_hash` / `effective_banner_hash` →
# full URL on the frontend.
KUN_GALGAME_WIKI_NUXT_PUBLIC_IMAGE_CDN_BASE=https://image.kungal.com
