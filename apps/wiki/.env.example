# Galgame Wiki — frontend env example (LOCAL DEV against the infra dev stack).
#
# Copy to `.env` (this dir) and run `pnpm dev` (Nuxt dev server on :9421). Every
# var also has a code-level fallback in `nuxt.config.ts`; the values below make
# the wiki talk to the dev stack brought up by `docker-compose.dev.yml` at the
# repo root (see docs/dev-environment.md). Production MUST override them.
#
# `NUXT_PUBLIC_*` vars become client-readable via `useRuntimeConfig().public.*`,
# so DO NOT put secrets here.

# ─── API endpoints ───────────────────────────────────────────────────

# galgame_wiki backend (where /galgame, /tag, /admin, etc. live) — dev stack
# galgame service on :9280.
KUN_GALGAME_WIKI_NUXT_PUBLIC_API_BASE=http://127.0.0.1:9280/api

# OAuth server REST base — used for /auth/me, /oauth/token, /oauth/revoke.
# Dev stack oauth service on :9277.
KUN_GALGAME_WIKI_NUXT_PUBLIC_AUTH_API_BASE=http://127.0.0.1:9277/api/v1

# OAuth /authorize entry — typically same host as AUTH_API_BASE. Wiki redirects
# the browser here at login time.
KUN_GALGAME_WIKI_NUXT_PUBLIC_OAUTH_AUTHORIZE_BASE=http://127.0.0.1:9277/api/v1

# ─── OAuth client ────────────────────────────────────────────────────

# Wiki's OAuth client_id — its registered `oauth_clients` row (catalog_site
# galgame_wiki). Wiki is a PUBLIC client (SPA) → no client_secret; PKCE is
# mandatory (apps/wiki/app/composables/useOAuthLogin.ts). This 32-hex id survives
# a refresh-dev-db snapshot (the code fallback `galgame-wiki-admin` is a local-only
# placeholder that a prod-derived snapshot would drop).
KUN_GALGAME_WIKI_NUXT_PUBLIC_OAUTH_CLIENT_ID=53e9b5ea70bfc4e4d0700a9f7b8818e8

# Where the browser lands after the OAuth code flow completes. MUST be a
# registered redirect URI on the client row (the snapshot ensures :9421 is present).
KUN_GALGAME_WIKI_NUXT_PUBLIC_OAUTH_REDIRECT_URI=http://127.0.0.1:9421/auth/callback

# ─── image_service ───────────────────────────────────────────────────

# CDN base for image_service-served images (no trailing slash) → the dev stack's
# read-through proxy (:9290), which serves the <aa>/<bb>/<hash>.webp tree from
# local MinIO and falls back to the prod public CDN on a miss. Resolves
# `avatar_image_hash` / `effective_banner_hash` → full URL on the frontend.
KUN_GALGAME_WIKI_NUXT_PUBLIC_IMAGE_CDN_BASE=http://127.0.0.1:9290
