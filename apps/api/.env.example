# Server
KUN_FIBER_SERVER_HOST=127.0.0.1
KUN_FIBER_SERVER_PORT=9277
KUN_ENV=development
KUN_SITE_URL=http://127.0.0.1:9277

# Nuxt4 dev server
KUN_FRONTEND_CORS_ORIGIN=http://127.0.0.1:9420,http://127.0.0.1:9421

# PostgreSQL
KUN_PG_HOST=localhost
KUN_PG_PORT=5432
KUN_PG_USER=postgres
KUN_PG_PASSWORD=your_password_here
KUN_PG_DATABASE=kun_oauth_admin
KUN_PG_SSLMODE=disable
KUN_PG_TIMEZONE=Asia/Shanghai

# Redis
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your_jwt_secret_here_at_least_32_characters
JWT_COOKIE_NAME=kun_token
JWT_EXPIRES=90d

# Meilisearch
KUN_MEILISEARCH_HOST=http://127.0.0.1:7700
KUN_MEILISEARCH_API_KEY=
KUN_MEILISEARCH_INDEX_PREFIX=

# Image Service
KUN_IMAGE_SERVICE_HOST=127.0.0.1
KUN_IMAGE_SERVICE_PORT=9278
KUN_IMAGE_PUBLIC_BASE_URL=http://127.0.0.1:9000/kun-images-dev
KUN_IMAGE_PRESETS_PATH=apps/api/configs/image_presets.yaml

# Image Service: dedicated Postgres (defaults to main KUN_PG_* + database kun_images)
KUN_IMAGES_PG_DATABASE=kun_images

# Image Service: S3 (MinIO compat for dev)
KUN_IMAGE_S3_ENDPOINT=http://127.0.0.1:9000
KUN_IMAGE_S3_REGION=us-east-1
KUN_IMAGE_S3_ACCESS_KEY=minioadmin
KUN_IMAGE_S3_SECRET_KEY=minioadmin
KUN_IMAGE_S3_BUCKET=kun-images-dev
KUN_IMAGE_S3_FORCE_PATH_STYLE=true

# Image client (caller-side: cmd/galgame, cmd/oauth, migration scripts call image_service)
# 默认 BaseURL = http://<KUN_IMAGE_SERVICE_HOST>:<KUN_IMAGE_SERVICE_PORT>
KUN_IMAGE_CLIENT_BASE_URL=
KUN_IMAGE_CLIENT_ID=kungal-test
KUN_IMAGE_CLIENT_SECRET=test-secret-dev
