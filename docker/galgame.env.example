# galgame wiki API.
# Copy to docker/galgame.env and fill secrets. Read at RUNTIME via env_file;
# never baked into an image, never committed. TEST values are throwaway.
KUN_ENV=production
KUN_FIBER_SERVER_HOST=0.0.0.0
KUN_GALGAME_PORT=9280
KUN_FRONTEND_CORS_ORIGIN=http://localhost:15008,http://127.0.0.1:15008,http://localhost:15009,http://127.0.0.1:15009,http://localhost:15011,http://127.0.0.1:15011,http://localhost:15013,http://127.0.0.1:15013

# primary (oauth) DB — user lookups for downstream JWT identities
KUN_PG_HOST=postgres
KUN_PG_PORT=5432
KUN_PG_USER=postgres
KUN_PG_PASSWORD=191007
KUN_PG_DATABASE=kun_galgame_infra
KUN_PG_SSLMODE=disable
KUN_PG_TIMEZONE=Asia/Shanghai

# galgame wiki DB (schema built by `cmd/migrate-galgame`)
KUN_GALGAME_PG_DATABASE=kun_galgame_wiki

# Same secret as oauth so downstream JWT signatures verify (MUST match oauth.env).
JWT_SECRET=kun-docker-test-jwt-secret-change-me-please

# Meilisearch (full-text search; EnsureIndexes is non-fatal if unavailable).
# KUN_MEILISEARCH_API_KEY MUST equal infra meili's MEILI_MASTER_KEY.
KUN_MEILISEARCH_HOST=http://meili:7700
KUN_MEILISEARCH_API_KEY=kun_docker_test_meili_master_key_change_me
