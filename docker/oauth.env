# oauth service (identity hub). TEST values — rotate secrets for real deploys.
KUN_ENV=production
KUN_FIBER_SERVER_HOST=0.0.0.0
KUN_FIBER_SERVER_PORT=9277
KUN_SITE_URL=http://localhost:15005
KUN_FRONTEND_URL=http://localhost:15008
# Dev: allow both localhost AND 127.0.0.1 for every web origin (a 127.0.0.1
# page hitting a localhost API is cross-origin → preflight needs both). Prod:
# replace with the real https web domains.
KUN_FRONTEND_CORS_ORIGIN=http://localhost:15008,http://127.0.0.1:15008,http://localhost:15009,http://127.0.0.1:15009,http://localhost:15011,http://127.0.0.1:15011,http://localhost:15013,http://127.0.0.1:15013

# --- Postgres (oauth + galgame + images DBs share one server) ---
KUN_PG_HOST=postgres
KUN_PG_PORT=5432
KUN_PG_USER=postgres
KUN_PG_PASSWORD=191007
KUN_PG_DATABASE=kun_galgame_infra
KUN_PG_SSLMODE=disable
KUN_PG_TIMEZONE=Asia/Shanghai
KUN_GALGAME_PG_DATABASE=kun_galgame_wiki
KUN_IMAGES_PG_DATABASE=kun_images

# --- Redis ---
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379

# --- JWT (required by config.validate) ---
JWT_SECRET=kun-docker-test-jwt-secret-change-me-please

# --- image_service admin endpoints embedded in oauth need S3 + images DB ---
KUN_IMAGE_S3_ENDPOINT=http://minio:9000
KUN_IMAGE_S3_REGION=us-east-1
KUN_IMAGE_S3_ACCESS_KEY=minioadmin
KUN_IMAGE_S3_SECRET_KEY=minioadmin
KUN_IMAGE_S3_BUCKET=kun-images
KUN_IMAGE_S3_FORCE_PATH_STYLE=true
KUN_IMAGE_PUBLIC_BASE_URL=http://localhost:15002/kun-images

# --- server-to-server image client (avatar upload + GC); optional ---
KUN_IMAGE_CLIENT_BASE_URL=http://image:9278
# KUN_IMAGE_CLIENT_ID=
# KUN_IMAGE_CLIENT_SECRET=

# --- mail (registration / password-reset / email-change verification) ---
# Test credentials mirrored from apps/api/.env. NOTE: docker env_file takes the
# raw value after `=` (it does NOT strip quotes the way godotenv does), so the
# password is written unquoted even though it contains special chars.
KUN_VISUAL_NOVEL_EMAIL_FROM=KUN VISUAL NOVEL
KUN_VISUAL_NOVEL_EMAIL_HOST=tuesday.mxrouting.net
KUN_VISUAL_NOVEL_EMAIL_PORT=587
KUN_VISUAL_NOVEL_EMAIL_ACCOUNT=auth@kungal.com
KUN_VISUAL_NOVEL_EMAIL_PASSWORD=8c72tf4g978&*#g9p8d^@G96RF@8t'vw啊这可海星鲲最可爱
